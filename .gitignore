# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Virtual Environments
venv/
.venv/
env/
ENV/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Datasets (large files ignored in git)
data/raw/*.csv
data/raw/*.tsv
data/processed/*.npz
data/processed/*.pkl
!data/raw/.gitkeep
!data/processed/.gitkeep

# Model weights & large binaries (keep the folder structure)
saved_models/*.h5
saved_models/*.keras
saved_models/*.pkl
!saved_models/.gitkeep

# IDE & OS specifics
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Environment variables
.env
